rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'ADMIN' ||
        request.auth.token.email == 'alopez@playaassoc.com'
      );
    }
    
    function isHR() {
      return isAuthenticated() && (
        getUserData().role in ['ADMIN', 'RH', 'RECURSOS_HUMANOS'] ||
        request.auth.token.email == 'alopez@playaassoc.com'
      );
    }
    
    function isManager() {
      return isAuthenticated() && (
        getUserData().role in ['ADMIN', 'RH', 'RECURSOS_HUMANOS', 'GERENTE', 'GERENTE_DEPARTAMENTO'] ||
        request.auth.token.email == 'alopez@playaassoc.com'
      );
    }
    
    // User collection: user can read their own or admins/HR can read all
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Allow authenticated users to read and write app collections with business logic
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
